######################################
# VisionLink: hand-gesture HMI for the STM32N6570-DK on micro T-Kernel 3.0
#
#   make -j8                 build and sign  -> build/VisionLink_sign.hex
#   make -j8 APP_DIAG=2      a build option (see "build options" below)
#   make clean               needed after changing any option
#
# See README.md for the toolchain, flashing and the full option list.
######################################

######################################
# quiet mode
######################################
V = 0
ifeq ($(V), 0)
  quiet = quiet_
else
  quiet =
endif
quiet_CC  = @echo "  CC $@"; $(CC)
quiet_LD  = @echo "  LD $@"; $(CC)
quiet_AS  = @echo "  AS $@"; $(AS)
quiet_SZ  = @echo "  SZ $@"; $(SZ)
quiet_HEX  = @echo "  HEX $@"; $(HEX)
quiet_BIN  = @echo "  BIN $@"; $(BIN)

######################################
# helpers
######################################
rwildcard=$(foreach d,$(wildcard $(1:=/*)),$(call rwildcard,$d,$2) $(filter $(subst *,%,$2),$d))

######################################
# target and layout
######################################
TARGET = VisionLink

# App/        VisionLink application
# Platform/   start-up, micro T-Kernel layer, library configuration, linker script
# ThirdParty/ vendored code (TP_DIR is used by mks/*.mk)
# Model/      network code generated by Model/generate-n6-model.sh
APP_DIR      := App
PLATFORM_DIR := Platform
TP_DIR       := ThirdParty
MODEL_DIR    := Model
BUILD_DIR    := build

######################################
# build options
######################################
# Camera sensors supported. All are compiled in; the one fitted is detected at
# run time. Options: IMX335 VD66GY VD55G1
SENSOR_LIST = IMX335 VD66GY VD55G1

# Which control scheme the power-on chooser starts highlighted on. All three
# (ASSISTED, ACROBATIC, PRESENTER) are always compiled in; the chooser and the
# menu switch between them at run time.
APP_DEFAULT_MODE ?= ASSISTED
C_DEFS += -DAPP_DEFAULT_MODE=APP_MODE_$(APP_DEFAULT_MODE)

# Diagnostic build level; see APP_DIAG in App/Src/app.c.
#   0 full pipeline   1 no inference   2 no inference and no camera
APP_DIAG ?= 0
C_DEFS += -DAPP_DIAG=$(APP_DIAG)

# Which way round the camera sees you. 0 = the raw sensor view, where the
# user's left hand appears on the RIGHT of the screen; 1 = mirrored, selfie
# style, left hand on the left. Every control scheme shares this, so it is one
# switch rather than a per-module define that could drift apart.
CAMERA_MIRRORED ?= 1
C_DEFS += -DHMI_CAMERA_IS_MIRRORED=$(CAMERA_MIRRORED)
C_DEFS += -DPRES_CAMERA_IS_MIRRORED=$(CAMERA_MIRRORED)

# Presenter mode. OFF leaves out the HaGRID classifier, hand_pose and
# presenter.c entirely, and the chooser offers only the two drone modes.
PRESENTER ?= ON
ifeq ($(PRESENTER), ON)
C_DEFS += -DAPP_HAS_PRESENTER=1
C_SOURCES += $(APP_DIR)/Src/gesture_hagrid.c
C_SOURCES += $(APP_DIR)/Src/hand_pose.c
C_SOURCES += $(APP_DIR)/Src/presenter.c
else
C_DEFS += -DAPP_HAS_PRESENTER=0
endif

# UTK_TRACE (micro T-Kernel bring-up trace) is defined in mks/utkernel.mk.

######################################
# building variables
######################################
OPT = -Os -g3

######################################
# source
######################################
# Application
C_SOURCES += $(APP_DIR)/Src/app.c
C_SOURCES += $(APP_DIR)/Src/ld.c
C_SOURCES += $(APP_DIR)/Src/gesture.c
C_SOURCES += $(APP_DIR)/Src/hmi.c
C_SOURCES += $(APP_DIR)/Src/ui.c
C_SOURCES += $(APP_DIR)/Src/app_mode.c
C_SOURCES += $(APP_DIR)/Src/stm32_lcd_ex.c
C_SOURCES += $(APP_DIR)/Src/app_cam.c
# Platform
C_SOURCES += $(PLATFORM_DIR)/Src/main.c
C_SOURCES += $(PLATFORM_DIR)/Src/app_fuseprogramming.c
C_SOURCES += $(PLATFORM_DIR)/Src/stm32n6xx_it.c
C_SOURCES += $(PLATFORM_DIR)/Src/utk_bsp.c
C_SOURCES += $(PLATFORM_DIR)/Src/os_utk.c
# Networks, generated by Model/generate-n6-model.sh
C_SOURCES += $(MODEL_DIR)/palm_detector.c
C_SOURCES += $(MODEL_DIR)/hand_landmark.c
# App/Src/usb_hid.c comes from mks/usbx_hid.mk, Platform/Gcc/*.c from
# mks/gcc.mk, and the micro T-Kernel OSAL for the NPU from mks/ai.mk.

# ASM sources
ASM_SOURCES =
ASM_SOURCES_S =

#######################################
# binaries
#######################################
PREFIX = arm-none-eabi-
# The gcc compiler bin path can be either defined in make command via GCC_PATH variable (> make GCC_PATH=xxx)
# either it can be added to the PATH environment variable.
ifdef GCC_PATH
CC = $(GCC_PATH)/$(PREFIX)gcc
AS = $(GCC_PATH)/$(PREFIX)gcc -x assembler-with-cpp
CP = $(GCC_PATH)/$(PREFIX)objcopy
SZ = $(GCC_PATH)/$(PREFIX)size
READELF = $(GCC_PATH)/$(PREFIX)readelf
else
CC = $(PREFIX)gcc
AS = $(PREFIX)gcc -x assembler-with-cpp
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size
READELF = $(PREFIX)readelf
endif
LD = $(CC)
HEX = $(CP) -O ihex
BIN = $(CP) -O binary

#######################################
# CFLAGS
#######################################
CPU = -mcpu=cortex-m55 -mcmse -mthumb
FPU = -mfpu=fpv5-d16 -mfloat-abi=hard

# mcu
MCU = $(CPU) $(FPU)

# C defines
C_DEFS += -DSTM32N657xx
C_DEFS += -DUSE_FULL_ASSERT
C_DEFS += -DUSE_FULL_LL_DRIVER
C_DEFS += -DVECT_TAB_SRAM
C_DEFS += $(foreach SENSOR, $(SENSOR_LIST), -DUSE_$(SENSOR)_SENSOR)

# Board: STM32N6570-DK only. VisionLink's touch interface needs its panel.
C_DEFS += -DSTM32N6570_DK_REV
C_DEFS += -DHAS_ROTATION_SUPPORT=1

# We only support single model
C_DEFS += -DTX_MAX_PARALLEL_NETWORKS=1

# C includes
C_INCLUDES += -I$(APP_DIR)/Inc
C_INCLUDES += -I$(PLATFORM_DIR)/Inc
# For Model/pd_anchors.c, the palm detector's anchor table, which ST's
# post-processing wrapper #includes as a source file.
C_INCLUDES += -I$(MODEL_DIR)
# Before mks/fw.mk on purpose: the vendored touch driver must shadow
# STM32Cube_FW_N6's stm32n6570_discovery_ts.h. See mks/touch.mk.
C_INCLUDES += -I$(TP_DIR)/touchscreen/STM32N6570-DK
C_INCLUDES += -I$(TP_DIR)/touchscreen/Components/gt911

ASFLAGS = $(MCU) $(AS_DEFS) $(AS_INCLUDES) $(OPT) -Wall -fstack-usage -fdata-sections -ffunction-sections -fcyclomatic-complexity
CFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fstack-usage -fdata-sections -ffunction-sections -fcyclomatic-complexity
# Generate dependency information
CFLAGS += -MMD -MP -MF"$(@:%.o=%.d)"

CFLAGS += -std=gnu11

#######################################
# LDFLAGS
#######################################
# link script
LDSCRIPT = $(PLATFORM_DIR)/Gcc/STM32N657xx.ld

# libraries
LIBS = -lc -lm -lnosys
LIBDIR =
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) $(LIBDIR) $(LIBS) $(LDFLAGS_OTHERS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections
# Uncomment to enable %f formatted output
LDFLAGS_OTHERS += -u _printf_float
# Avoid 'build/Project.elf has a LOAD segment with RWX permissions' warning
LDFLAGS_OTHERS += -Wl,--no-warn-rwx-segments
LDFLAGS += -Wl,--print-memory-usage

# default action: build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

#######################################
# Include mk files
#######################################
include mks/fw.mk
include mks/touch.mk
include mks/ai.mk
include mks/cmw.mk
include mks/utkernel.mk
include mks/usbx_hid.mk
include mks/gcc.mk
include mks/ipl.mk
# Screen library, LTDC back-end
SCR_LIB_SCREEN_ITF ?= LTDC
SCR_USBX_REL_DIR := $(TP_DIR)/STM32Cube_FW_N6/Middlewares/ST/usbx
SCR_LIB_RTOS := NONE
include $(TP_DIR)/screenl/scr_lib.mk
include mks/nema.mk

#######################################
# build the application
#######################################
OBJECTS = $(addprefix $(BUILD_DIR)/, $(C_SOURCES:.c=.o))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(ASM_SOURCES:.s=.o))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(ASM_SOURCES_S:.S=.o))


$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$($(quiet)CC)  -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.S Makefile | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$($(quiet)CC)  -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$($(quiet)AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).list: $(OBJECTS)
	$(file > $@, $(OBJECTS))

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile $(BUILD_DIR)/$(TARGET).list
	$($(quiet)LD) @$(BUILD_DIR)/$(TARGET).list $(LDFLAGS) -o $@
	$($(quiet)SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$($(quiet)HEX) $< $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$($(quiet)BIN) $< $@

$(BUILD_DIR):
	mkdir -p $@

#######################################
# clean up
#######################################
clean:
	-rm -fR $(BUILD_DIR)

#######################################
# dependencies
#######################################
-include $(call rwildcard,$(BUILD_DIR),*.d)

#######################################
# signing
#######################################
# The boot ROM only starts a signed image. The signed image is also written as
# Intel HEX at its flash address, 0x70100000, so it can be flashed without
# typing an address.
SIGNING_TOOL ?= C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_SigningTool_CLI.exe

all: $(BUILD_DIR)/$(TARGET)_sign.hex

$(BUILD_DIR)/$(TARGET)_sign.bin: $(BUILD_DIR)/$(TARGET).bin
	rm -f $@
	"$(SIGNING_TOOL)" -bin $< -nk -t ssbl -hv 2.3 -o $@ -s

$(BUILD_DIR)/$(TARGET)_sign.hex: $(BUILD_DIR)/$(TARGET)_sign.bin
	$(CP) -I binary $< --change-addresses 0x70100000 -O ihex $@
